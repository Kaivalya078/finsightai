# =============================================================================
# Cognifin — Backend Configuration
# =============================================================================
# Copy to .env and fill in the SECRETS section. Never commit .env.
#
# Keys marked [RE-INGEST] change how the corpus is indexed. Changing one makes
# the existing index invalid — you must re-run ingestion or retrieval will
# crash on a dimension mismatch or return garbage.
#
# Every key below is a field in config.py, which is the only place defaults
# live. A key in .env that config.py doesn't know is rejected at startup.
# =============================================================================


# -----------------------------------------------------------------------------
# SECRETS — required, no safe defaults
# -----------------------------------------------------------------------------
# The app refuses to start if JWT_SECRET is unset or left at a placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OPENAI_API_KEY=
MONGO_URI=

# Google OAuth — from console.cloud.google.com > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback


# -----------------------------------------------------------------------------
# PATHS
# -----------------------------------------------------------------------------
PDF_PATH=data
INDEX_CACHE_DIR=index_cache


# -----------------------------------------------------------------------------
# CHUNKING  [RE-INGEST]
# -----------------------------------------------------------------------------
# Target characters per chunk for prose. Tables are kept whole where possible
# and are not split at this boundary.
CHUNK_SIZE=900
CHUNK_OVERLAP=150


# -----------------------------------------------------------------------------
# EMBEDDING MODEL  [RE-INGEST]
# -----------------------------------------------------------------------------
# The index currently on disk was built with all-MiniLM-L6-v2 (384-dim).
# Do NOT switch models without re-ingesting — a 768-dim query against a
# 384-dim index fails at startup.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Recommended upgrade, to apply during the next full re-ingest. bge-base is
# markedly stronger on retrieval and is worth the 768 dims. It also expects a
# query prefix — uncomment QUERY_INSTRUCTION with it, or recall degrades.
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
QUERY_INSTRUCTION=


# -----------------------------------------------------------------------------
# RETRIEVAL
# -----------------------------------------------------------------------------
# RETRIEVAL_K: candidates fetched before reranking. This wants to be LARGE —
#   the cross-encoder exists to rank a wide net precisely. At K=10 the reranker
#   never sees a chunk that the bi-encoder ranked 15th, so it cannot help you.
# FINAL_K: chunks handed to the LLM after reranking.
# TOP_K: default result count for API responses when the caller omits it.
RETRIEVAL_K=60
FINAL_K=8
TOP_K=5

# Minimum cosine similarity for a chunk to be considered at all.
SIMILARITY_THRESHOLD=0.30

# Neighbouring chunks to attach on each side of a hit. 1 gives the LLM the
# sentence before and after instead of an isolated fragment.
CONTEXT_WINDOW=1


# -----------------------------------------------------------------------------
# RERANKING
# -----------------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

# Hard cap on pairs sent to the cross-encoder, protecting tail latency when
# RETRIEVAL_K is raised. Keep at or above RETRIEVAL_K to rerank everything.
RERANKER_MAX_CANDIDATES=60

# Skip reranking entirely when the top bi-encoder score already exceeds this —
# an obvious match does not need a second opinion.
SKIP_RERANKER_THRESHOLD=0.85


# -----------------------------------------------------------------------------
# HYBRID SEARCH
# -----------------------------------------------------------------------------
# Keyword search alongside vectors. Essential for exact matches that embeddings
# miss: scheme names, section numbers, defined terms.
BM25_ENABLED=true

# Reciprocal Rank Fusion constant for merging vector and keyword rankings.
RRF_K=60


# -----------------------------------------------------------------------------
# QUERY UNDERSTANDING
# -----------------------------------------------------------------------------
# Both of these add an LLM round-trip per request — together roughly 4-6s of
# latency and ~3x the token spend. Leave OFF unless you have measured that
# they earn it on your eval set.
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3
INTELLIGENT_PARSING_ENABLED=false

MAX_RETRIEVAL_STEPS=3
MULTI_STEP_RETRIEVAL_K=10


# -----------------------------------------------------------------------------
# RANKING ADJUSTMENTS
# -----------------------------------------------------------------------------
# Added to a chunk's score when its metadata matches the parsed query.
# Additive, not multipliers: scores sit in 0-1, so keep these small.
BOOST_COMPANY=0.08
BOOST_YEAR=0.04
BOOST_DOCTYPE=0.03

# Near-duplicate suppression, and limits on how much of the final result set
# one document may occupy.
DEDUP_THRESHOLD=0.85
MAX_FROM_ONE_DOC=0.6
MAX_DOC_CONCENTRATION=0.6

# Fallback scope when the query names no company/year/type.
DEFAULT_COMPANY=
DEFAULT_DOC_TYPE=
DEFAULT_YEAR=


# -----------------------------------------------------------------------------
# GENERATION
# -----------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint. Empty = api.openai.com. For Gemini:
# https://generativelanguage.googleapis.com/v1beta/openai/ (then OPENAI_MODEL=gemini-2.0-flash)
OPENAI_BASE_URL=


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
MONGO_DB_NAME=Cognifin


# -----------------------------------------------------------------------------
# CORS / FRONTEND
# -----------------------------------------------------------------------------
# Comma-separated. MUST include the deployed frontend origin or the browser
# blocks every request. Defaulting this to localhost is why production breaks.
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# RESPONSE CACHE
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_MAX_SIZE=500
CACHE_TTL_SECONDS=3600


# -----------------------------------------------------------------------------
# ASSETS / DEPLOYMENT
# -----------------------------------------------------------------------------
# local  = read the index from INDEX_CACHE_DIR on disk (development)
# remote = download and extract it from HF_CACHE_URL at boot (deployment)
ASSET_MODE=local
HF_CACHE_URL=

# Base URL the frontend uses to open source PDFs. Empty = serve from this API
# (fine locally). In production point it at object storage so the app server
# is not shipping 2 GB of PDFs.
HF_PDF_BASE_URL=


# -----------------------------------------------------------------------------
# UPLOADS
# -----------------------------------------------------------------------------
# Largest PDF /upload accepts. Ingestion is CPU-bound and held in RAM.
UPLOAD_MAX_MB=25


# -----------------------------------------------------------------------------
# RATE LIMITS
# -----------------------------------------------------------------------------
# /chat without login: this many questions per IP per day, then a sign-in prompt.
ANON_FREE_QUESTIONS=5
# /chat for signed-in users, per account. Each uncached question is an LLM call.
RATE_LIMIT_CHAT=20/minute;300/day


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
QUERY_LOG_ENABLED=false
