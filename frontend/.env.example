# Cognifin frontend. Local dev reads .env.development; production values are
# set in the Vercel project (Settings > Environment Variables), not committed.

# The FastAPI backend. `npm run build` refuses to run unless this is https://.
VITE_API_BASE=http://localhost:8000

# This site's own public URL, no trailing slash. Link previews (LinkedIn, X,
# Slack) need an absolute og:image, built from this. e.g. https://cognifin.vercel.app
VITE_SITE_URL=
